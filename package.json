{
  "name": "qb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm run check:bundle",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "e2e": "playwright test",
    "e2e:qb445": "sh scripts/e2e-compat.sh qb445 e2e/compatibility.spec.ts",
    "e2e:qb523": "sh scripts/e2e-compat.sh qb523 e2e/compatibility.spec.ts",
    "e2e:metadata": "sh scripts/e2e-compat.sh qb523 e2e/metadata.spec.ts",
    "e2e:details": "sh scripts/e2e-compat.sh qb523 e2e/details.spec.ts",
    "e2e:bulk:qb445": "sh scripts/e2e-compat.sh qb445 e2e/bulk-actions.spec.ts",
    "e2e:bulk:qb523": "sh scripts/e2e-compat.sh qb523 e2e/bulk-actions.spec.ts",
    "e2e:visual": "sh scripts/e2e-compat.sh qb523 e2e/visual.spec.ts --browser=all --workers=1",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "immer": "^11.2.9",
    "jotai": "^3.0.1",
    "jotai-optics": "^0.4.0",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "virtua": "^0.54.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
